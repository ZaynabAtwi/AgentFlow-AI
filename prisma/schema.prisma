generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubscriptionPlan {
  FREE
  STUDENT
  PROFESSIONAL
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CLOSED
}

enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String?
  name              String?
  role              Role             @default(USER)
  subscriptionPlan  SubscriptionPlan @default(FREE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  leads             Lead[]
  agents            Agent[]
  campaigns         Campaign[]
  auditLogs         AuditLog[]
}

model Lead {
  id               String      @id @default(cuid())
  userId           String
  name             String
  website          String?
  email            String?
  phone            String?
  address          String?
  industry         String?
  location         String?
  score            Int         @default(0)
  scoreReason      String?
  status           LeadStatus  @default(NEW)
  hasChatbot       Boolean     @default(false)
  outdatedUx       Boolean     @default(false)
  hasBookingSystem Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents           Agent[]
}

model Agent {
  id               String   @id @default(cuid())
  userId           String
  leadId           String?
  name             String
  systemPrompt     String
  tone             String   @default("friendly")
  knowledgeBase    String
  flowsJson        Json?
  demoToken        String   @unique
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead             Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model Campaign {
  id              String         @id @default(cuid())
  userId          String
  name            String
  leadIds         String[]
  emailMessage    String
  smsMessage      String?
  status          CampaignStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String
  action          String
  meta            Json?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
